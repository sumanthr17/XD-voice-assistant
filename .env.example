# Create a key at https://aistudio.google.com/ and keep it only in .env.
GEMINI_API_KEY=

# Select a model available to your API key. Run XD AI and type /models to list them.
GEMINI_MODEL=gemini-3.1-flash-lite

# Number of completed user/assistant turns retained for this terminal session.
XD_AI_MAX_HISTORY_TURNS=10

