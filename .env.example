# Create a key at https://aistudio.google.com/ and keep it only in .env.
GEMINI_API_KEY=

# Select a model available to your API key. Run XD AI and type /models to list them.
GEMINI_MODEL=gemini-3.1-flash-lite

# Number of completed user/assistant turns retained for this terminal session.
XD_AI_MAX_HISTORY_TURNS=10

# Voice input: leave blank for the Windows default microphone. Use /devices and
# prefer a device number when Windows exposes duplicate names.
XD_AI_MICROPHONE=

# Leave blank to use the microphone's native sample rate.
XD_AI_SAMPLE_RATE=

# Local Faster-Whisper settings. base.en is a practical CPU-first default.
XD_AI_WHISPER_MODEL=base.en
XD_AI_WHISPER_DEVICE=cpu
XD_AI_WHISPER_COMPUTE_TYPE=int8

# Local Windows text-to-speech settings. Voice can be an installed voice name or ID.
XD_AI_TTS_RATE=175
XD_AI_TTS_VOICE=

